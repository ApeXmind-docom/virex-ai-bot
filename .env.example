# ============================================================
# IA VIREX — Variables de entorno
# Copia este archivo como .env en local, o cárgalas en Render
# (Settings > Environment) para producción.
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Modelo económico para conversación de alto volumen por WhatsApp.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Identidad del bot ---
BOT_NAME=IA VIREX
BOT_WHATSAPP_NUMBER=573117591899

# --- Producto (actualizar SOLO con datos confirmados por el fabricante) ---
# Mientras la ficha técnica no esté confirmada, deja DOSIS_CONFIRMADA=false.
# El bot habla de la dosis como "indicación general" hasta que esto cambie.
DOSIS_CONFIRMADA=false
DOSIS_TEXTO="1 cápsula a media mañana y 1 cápsula antes de acostarte (2 al día)"

# Enlace de compra/pago. El cliente ya tiene un botón de pago propio —
# pega aquí esa URL cuando la tengas. Mientras esté vacío, el bot cierra
# la venta tomando el pedido directo por WhatsApp (pago contra entrega).
PRODUCT_URL=https://link.mercadopago.com.co/soylatin

# --- Precios (del manual comercial del cliente, agosto 2026) ---
PRICE_1_BOTTLE=$130.000
PRICE_2_BOTTLES=$230.000
PRICE_3_BOTTLES=$300.000

# Descuento por referidos (ver nota en la landing: valor de ejemplo,
# confirmar contra la política comercial real antes de producción).
REFERRAL_DISCOUNT=15%

# --- Controles de costo (lección aprendida de KAIA: nunca desplegar sin esto) ---
# Máximo de llamadas a la API de Claude por día, en TODA la cuenta.
MAX_DAILY_API_CALLS=300
# Máximo de mensajes que UN usuario puede enviar por hora.
MAX_USER_MESSAGES_PER_HOUR=12
# Máximo de tokens de salida por respuesta (WhatsApp = respuestas cortas).
MAX_OUTPUT_TOKENS=280
# Cuántos mensajes previos de la conversación se le pasan a Claude como contexto.
HISTORY_WINDOW=10

# --- Persistencia ---
# Ruta del archivo SQLite. En Render, debe vivir en un disco persistente
# (Settings > Disks), o la sesión de WhatsApp y el historial se pierden
# en cada redeploy.
DB_PATH=/data/virex-ai.db
BAILEYS_AUTH_PATH=/data/baileys-auth

# --- Puerto (Render lo inyecta automáticamente, no lo cambies a mano) ---
PORT=3000

# ============================================================
# Paola (asistente VIREX) — Variables de entorno
# Copia este archivo como .env en local, o cárgalas en Render
# (Settings > Environment) para producción.
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Identidad del bot ---
BOT_NAME=Paola
BOT_WHATSAPP_NUMBER=573104681701

# --- Producto ---
DOSIS_CONFIRMADA=false
DOSIS_TEXTO=1 cápsula a media mañana y 1 cápsula antes de acostarte (2 al día)
PRODUCT_URL=https://link.mercadopago.com.co/soylatin

# --- Precios ---
PRICE_1_BOTTLE=$130.000
PRICE_2_BOTTLES=$230.000
PRICE_3_BOTTLES=$300.000

# --- Promoción de referidos: 3 amigos = 20% de descuento ---
REFERRAL_COUNT=3
REFERRAL_DISCOUNT=20%

# --- Controles de costo ---
MAX_DAILY_API_CALLS=300
MAX_USER_MESSAGES_PER_HOUR=12
MAX_OUTPUT_TOKENS=280
HISTORY_WINDOW=10

# --- Persistencia ---
DB_PATH=/data/virex-ai.db
BAILEYS_AUTH_PATH=/data/baileys-auth

# --- Puerto ---
PORT=3000

# --- Panel de administración ---
ADMIN_PASSWORD=

# --- Video de bienvenida (opcional) ---
# Se envía de inmediato en el primer mensaje de cada persona, antes del saludo.
# Opción A: URL pública directa a un .mp4 en esta variable.
# Opción B: dejar el archivo en src/assets/bienvenida.mp4 (máx. ~16 MB, WhatsApp).
# Si no hay ninguno de los dos, el primer contacto va solo con el saludo.
VIREX_VIDEO_URL=

# --- Imagen de precios (opcional) ---
# Por defecto se usa src/assets/oferta-virex.jpg. La imagen trae los precios
# escritos: si cambias PRICE_*_BOTTLE(S), reemplaza también la imagen.
# PRICE_IMAGE_PATH=
